{
  "name": "trace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build:engine": "esbuild packages/engine/src/index.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=supabase/functions/_shared/engine.js",
    "build": "npm run build:engine && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:edge": "node --experimental-strip-types scripts/test-edge-functions.ts",
    "check:ds": "node scripts/check-design-system.mjs"
  },
  "dependencies": {
    "@trace/engine": "*",
    "@ai-sdk/anthropic": "^4.0.88",
    "@ai-sdk/google": "^4.0.105",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "ai": "^7.0.153",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.6.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^1.9.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
